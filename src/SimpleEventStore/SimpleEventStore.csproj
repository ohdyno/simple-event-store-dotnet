<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>SimpleEventStore</AssemblyName>
    <RootNamespace>SimpleEventStore</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <IsPackable>true</IsPackable>
    <PackageId>SimpleEventStore</PackageId>
    <Version>1.0.0</Version>
    <Authors>Xing Zhou</Authors>
    <Description>A small asynchronous event store with in-memory and PostgreSQL adapters.</Description>
    <PackageTags>event-sourcing;event-store;postgresql</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/ohdyno/simple-event-store-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="System.Reactive" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Schema/schema.sql" LogicalName="SimpleEventStore.Schema.schema.sql" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
